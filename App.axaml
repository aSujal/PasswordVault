<Application
	RequestedThemeVariant="Default"
    x:Class="PasswordVault.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:PasswordVault.Converters"
    xmlns:themes="clr-namespace:ShadUI.Themes;assembly=ShadUI">

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.ThemeDictionaries>
				<ResourceInclude Source="Themes/Light.axaml" x:Key="Light" />
				<ResourceInclude Source="Themes/Dark.axaml" x:Key="Dark" />
			</ResourceDictionary.ThemeDictionaries>
		</ResourceDictionary>
		<converters:JoinConverter x:Key="JoinConverter" Separator=", " />
		<converters:StringToLucideIconConverter x:Key="StringToLucideIconConverter" />
		<x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
	</Application.Resources>

	<Application.Styles>
		<themes:ShadTheme/>
		<StyleInclude Source="avares://ThemeEditor.Controls.ColorPicker/ColorPicker.axaml" />
		<!--<FluentTheme/>-->
	</Application.Styles>
</Application>
