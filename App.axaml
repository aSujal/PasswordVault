<Application
    RequestedThemeVariant="Default"
    x:Class="PasswordVault.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:PasswordVault.Converters"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude Source="Themes/Light.axaml" x:Key="Light" />
                <ResourceInclude Source="Themes/Dark.axaml" x:Key="Dark" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
        <converters:JoinConverter x:Key="JoinConverter" Separator=", " />
        <!--<converters:BooleonConverters x:Key="BooleonConverters" />-->
        <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
    </Application.Resources>

    <Application.Styles>
        <shadui:ShadTheme/>
        <!--<StyleInclude Source="avares://ThemeEditor.Controls.ColorPicker/ColorPicker.axaml" />-->
        <!--<FluentTheme/>-->
    </Application.Styles>
</Application>