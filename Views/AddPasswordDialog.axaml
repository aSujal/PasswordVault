<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:PasswordVault.ViewModels"
			 xmlns:i="https://github.com/projektanker/icons.avalonia"
			 xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
			 xmlns:icons="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PasswordVault.Views.AddPasswordDialog"
			 x:DataType="vm:AddPasswordDialogViewModel">
	<Grid RowDefinitions="Auto,*,Auto" Margin="24" Width="500">
		<TextBlock Grid.Row="0" Text="{Binding DialogTitle, FallbackValue=Dialog}" Classes="h4" Margin="0,0,0,16"/>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="16">
				<!-- Site/Title -->
				<TextBox Watermark="Site or App Name" Text="{Binding Title, Mode=TwoWay}">
					<TextBox.InnerLeftContent>
						<icons:Lucide Icon="Globe" StrokeBrush="{DynamicResource ForegroundColor}" Opacity="0.75" Height="16" Width="16" Margin="8,0,0,0"/>
					</TextBox.InnerLeftContent>
				</TextBox>

				<!-- Username -->
				<TextBox Watermark="Username or Email" Text="{Binding Username, Mode=TwoWay}">
					<TextBox.InnerLeftContent>
						<icons:Lucide Icon="User" StrokeBrush="{DynamicResource ForegroundColor}" Opacity="0.75" Height="16" Width="16" Margin="8,0,0,0"/>
					</TextBox.InnerLeftContent>
				</TextBox>

				<!-- Password with Generator -->

				<Grid ColumnDefinitions="*,Auto">
					<TextBox Grid.Column="0" Watermark="Password" Text="{Binding Password, Mode=TwoWay}" PasswordChar="•" Classes="PasswordReveal">
						<TextBox.InnerLeftContent>
							<icons:Lucide Icon="Lock" StrokeBrush="{DynamicResource ForegroundColor}" Opacity="0.75" Height="16" Width="16" Margin="8,0,0,0"/>
						</TextBox.InnerLeftContent>
					</TextBox>
					<Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding GeneratePasswordCommand}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<icons:Lucide StrokeBrush="{DynamicResource ForegroundColor}" Icon="Sparkles" Height="16" Width="16"/>
							<TextBlock Text="Generate"/>
						</StackPanel>
					</Button>
				</Grid>

				<!-- Password Strength Indicator -->
				<StackPanel Spacing="8">
					<DockPanel>
						<TextBlock Text="{Binding PasswordStrengthText}"  DockPanel.Dock="Right"/>
						<TextBlock Text="Password Strength:"/>
					</DockPanel>
					<ProgressBar Value="{Binding PasswordStrength}" Maximum="100" Height="8">
						<ProgressBar.Styles>
							<Style Selector="ProgressBar">
								<Setter Property="Background" Value="Transparent"/>
								<Setter Property="Foreground" Value="{Binding PasswordStrengthColor, FallbackValue=Red}"/>
							</Style>
						</ProgressBar.Styles>
					</ProgressBar>
				</StackPanel>

				<!-- URL -->
				<TextBox Watermark="Website URL (optional)" Text="{Binding Url, Mode=TwoWay}">
					<TextBox.InnerLeftContent>
						<icons:Lucide Icon="Link" StrokeBrush="{DynamicResource ForegroundColor}" Opacity="0.75" Height="16" Width="16" Margin="8,0,0,0"/>
					</TextBox.InnerLeftContent>
				</TextBox>

				<!-- Category Selector -->
				<Grid ColumnDefinitions="*,Auto">
					<ComboBox Grid.Column="0" PlaceholderText="Select Category"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal" Spacing="10">
									<i:Icon Value="{Binding Icon}" Foreground="{Binding Color}"/>
									<TextBlock Text="{Binding Name}" Foreground="{Binding Color}"/>
								</StackPanel>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding CreateCategory}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<icons:Lucide Icon="Plus" StrokeBrush="{DynamicResource ForegroundColor}" Height="16" Width="16"/>
							<TextBlock Text="New"/>
						</StackPanel>
					</Button>
				</Grid>

				<!-- Notes -->
				<TextBox Watermark="Notes (optional)" Text="{Binding Notes, Mode=TwoWay}" AcceptsReturn="True">
					<TextBox.InnerLeftContent>
						<icons:Lucide Icon="FileText" StrokeBrush="{DynamicResource ForegroundColor}" Opacity="0.75" Height="16" Width="16" Margin="8,0,0,0"/>
					</TextBox.InnerLeftContent>
				</TextBox>

				<!-- Favorite Toggle -->
				<CheckBox Content="Mark as Favorite" IsChecked="{Binding IsFavorite, Mode=TwoWay}"/>
			</StackPanel>
		</ScrollViewer>

		<StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Command="{Binding CancelCommand}" Classes="Outline">Cancel</Button>
			<Button Command="{Binding SubmitCommand}" Classes="Primary" Content="{Binding SubmitButtonText, FallbackValue=Submit}"/>
		</StackPanel>
	</Grid>
</UserControl>
