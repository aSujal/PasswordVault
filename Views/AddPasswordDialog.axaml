<UserControl
	x:Class="PasswordVault.Views.AddPasswordDialog"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fa="clr-namespace:PasswordVault.CustomIcons"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
	xmlns:sys="using:System"
	xmlns:vm="using:PasswordVault.ViewModels"
	x:Name="Root"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="vm:AddPasswordDialogViewModel"
	mc:Ignorable="d">
	<Grid
		Width="500"
		Margin="24"
		RowDefinitions="Auto,*,Auto">
		<TextBlock
			Grid.Row="0"
			Margin="0,0,0,16"
			Classes="h4"
			Text="{Binding DialogTitle, FallbackValue=Dialog}" />

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="16">
				<!--  Site/Title  -->
				<TextBox PlaceholderText="Site or App Name" Text="{Binding Title, Mode=TwoWay}">
					<TextBox.InnerLeftContent>
						<fa:FontAwesomeIcon
							Width="16"
							Height="16"
							Margin="8,0,0,0"
							Foreground="{DynamicResource ForegroundColor}"
							Opacity="0.75"
							Value="fa-solid fa-globe" />
					</TextBox.InnerLeftContent>
				</TextBox>

				<!--  Username  -->
				<TextBox PlaceholderText="Username or Email" Text="{Binding Username, Mode=TwoWay}">
					<TextBox.InnerLeftContent>
						<fa:FontAwesomeIcon
							Width="16"
							Height="16"
							Margin="8,0,0,0"
							Foreground="{DynamicResource ForegroundColor}"
							Opacity="0.75"
							Value="fa-solid fa-user" />
					</TextBox.InnerLeftContent>
				</TextBox>

				<!--  Password with Generator  -->

				<Grid ColumnDefinitions="*,Auto,Auto">
					<TextBox
						Grid.Column="0"
						Classes="PasswordReveal"
						PasswordChar="•"
						PlaceholderText="Password"
						Text="{Binding Password, Mode=TwoWay}">
						<TextBox.InnerLeftContent>
							<fa:FontAwesomeIcon
								Width="16"
								Height="16"
								Margin="8,0,0,0"
								Foreground="{DynamicResource ForegroundColor}"
								Opacity="0.75"
								Value="fa-solid fa-lock" />
						</TextBox.InnerLeftContent>
					</TextBox>
					<CheckBox
						Grid.Column="1"
						Margin="8,0,8,0"
						VerticalAlignment="Center"
						Content="Memorable"
						IsChecked="{Binding UseMemorablePassword}" />
					<Button
						Grid.Column="2"
						Margin="0,0,0,0"
						Command="{Binding GeneratePasswordCommand}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<fa:FontAwesomeIcon
								Width="16"
								Height="16"
								Foreground="{DynamicResource ForegroundColor}"
								Value="fa-solid fa-wand-magic-sparkles" />
							<TextBlock Text="Generate" />
						</StackPanel>
					</Button>
				</Grid>

				<!--  Password Strength Indicator  -->
				<StackPanel Spacing="8">
					<DockPanel>
						<TextBlock DockPanel.Dock="Right" Text="{Binding PasswordStrengthText}" />
						<TextBlock Text="Password Strength:" />
					</DockPanel>
					<ProgressBar
						Height="8"
						Maximum="100"
						Value="{Binding PasswordStrength}">
						<ProgressBar.Styles>
							<Style Selector="ProgressBar">
								<Setter Property="Background" Value="Transparent" />
								<Setter Property="Foreground" Value="{Binding PasswordStrengthColor, FallbackValue=Red}" />
							</Style>
						</ProgressBar.Styles>
					</ProgressBar>
				</StackPanel>

				<!--  URL  -->
				<TextBox PlaceholderText="Website URL (optional)" Text="{Binding Url, Mode=TwoWay}">
					<TextBox.InnerLeftContent>
						<fa:FontAwesomeIcon
							Width="16"
							Height="16"
							Margin="8,0,0,0"
							Foreground="{DynamicResource ForegroundColor}"
							Opacity="0.75"
							Value="fa-solid fa-link" />
					</TextBox.InnerLeftContent>
				</TextBox>

				<!--  Category Selector  -->
				<StackPanel Spacing="8">
					<Grid ColumnDefinitions="*,Auto,Auto">
						<ComboBox
							Grid.Column="0"
							HorizontalAlignment="Stretch"
							ItemsSource="{Binding Categories}"
							PlaceholderText="Select Category"
							SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal" Spacing="10">
										<fa:FontAwesomeIcon Foreground="{Binding Color}" Value="{Binding Icon}" />
										<TextBlock Foreground="{Binding Color}" Text="{Binding Name}" />
									</StackPanel>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>

						<!--  AI Suggest Button  -->
						<Button
							Grid.Column="1"
							Margin="8,0,0,0"
							Classes="Outline"
							Command="{Binding SuggestCategoryCommand}"
							IsVisible="{Binding IsAiEnabled}"
							ToolTip.Tip="Auto-suggest category using AI">
							<fa:FontAwesomeIcon
								Width="16"
								Height="16"
								Foreground="{DynamicResource ForegroundColor}"
								Value="fa-solid fa-wand-magic-sparkles" />
						</Button>

						<Button
							Grid.Column="2"
							Margin="8,0,0,0"
							Command="{Binding CreateCategory}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<fa:FontAwesomeIcon
									Width="16"
									Height="16"
									Foreground="{DynamicResource ForegroundColor}"
									Value="fa-solid fa-plus" />
								<TextBlock Text="New" />
							</StackPanel>
						</Button>
					</Grid>

					<!--  AI Suggestion Chip  -->
					<shadui:Card
						Padding="12"
						Background="{DynamicResource OutlineColor}"
						IsVisible="{Binding HasAiSuggestion}">
						<Grid ColumnDefinitions="*,Auto,Auto">
							<StackPanel Grid.Column="0" VerticalAlignment="Center">
								<TextBlock
									Classes="p"
									FontWeight="Bold"
									Text="{Binding SuggestedCategoryName, StringFormat='Suggested Category: {0}'}" />
								<TextBlock
									Classes="p"
									FontSize="12"
									IsVisible="{Binding SuggestedTagsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
									Opacity="0.7"
									Text="{Binding SuggestedTagsText, StringFormat='Tags: {0}'}" />
							</StackPanel>
							<Button
								Grid.Column="1"
								Margin="8,0,0,0"
								Classes="Primary"
								Command="{Binding AcceptSuggestionCommand}">
								Accept
							</Button>
							<Button
								Grid.Column="2"
								Margin="8,0,0,0"
								Classes="Ghost"
								Command="{Binding DismissSuggestionCommand}">
								Dismiss
							</Button>
						</Grid>
					</shadui:Card>
				</StackPanel>

				<!--  Notes  -->
				<TextBox
					AcceptsReturn="True"
					PlaceholderText="Notes (optional)"
					Text="{Binding Notes, Mode=TwoWay}">
					<TextBox.InnerLeftContent>
						<fa:FontAwesomeIcon
							Width="16"
							Height="16"
							Margin="8,0,0,0"
							Foreground="{DynamicResource ForegroundColor}"
							Opacity="0.75"
							Value="fa-solid fa-file-lines" />
					</TextBox.InnerLeftContent>
				</TextBox>

				<!--  Favorite Toggle  -->
				<CheckBox Content="Mark as Favorite" IsChecked="{Binding IsFavorite, Mode=TwoWay}" />

				<!--  Two-Factor Authentication  -->
				<Expander Header="Two-Factor Authentication (optional)">
					<StackPanel Margin="0,12,0,0" Spacing="8">
						<TextBox PlaceholderText="2FA Secret Key (Base32) or a full otpauth:// URI" Text="{Binding TwoFactorSecret, Mode=TwoWay}">
							<TextBox.InnerLeftContent>
								<fa:FontAwesomeIcon
									Width="16"
									Height="16"
									Margin="8,0,0,0"
									Foreground="{DynamicResource ForegroundColor}"
									Opacity="0.75"
									Value="fa-solid fa-shield-halved" />
							</TextBox.InnerLeftContent>
						</TextBox>
						<TextBlock
							Classes="p"
							FontSize="12"
							Opacity="0.6"
							Text="Stores the secret so PasswordVault can generate live codes for this entry. Pasting a full otpauth:// URI also picks up its algorithm (e.g. SHA256), digit count, and period."
							TextWrapping="Wrap" />
					</StackPanel>
				</Expander>
			</StackPanel>
		</ScrollViewer>

		<StackPanel
			Grid.Row="2"
			Margin="0,16,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal"
			Spacing="8">
			<Button Classes="Destructive" Command="{Binding CancelCommand}">Cancel</Button>
			<Button
				Classes="Primary"
				Command="{Binding SubmitCommand}"
				Content="{Binding SubmitButtonText, FallbackValue=Submit}" />
		</StackPanel>
	</Grid>
</UserControl>
