<DataTemplates xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:viewModels="clr-namespace:PasswordVault.ViewModels"
               xmlns:pages="clr-namespace:PasswordVault.Views">
	<DataTemplate DataType="{x:Type viewModels:PasswordListViewModel}">
		<pages:PasswordsPage/>
	</DataTemplate>
	<DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
		<pages:DashboardPage/>
	</DataTemplate>
</DataTemplates>