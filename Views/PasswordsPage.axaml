<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			xmlns:ui="clr-namespace:ShadUI;assembly=ShadUI"
			xmlns:controls="clr-namespace:ShadUI.Controls;assembly=ShadUI"
			xmlns:extensions="clr-namespace:ShadUI.Extensions;assembly=ShadUI"
			xmlns:icons="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
			xmlns:i="https://github.com/projektanker/icons.avalonia"
			xmlns:converters="clr-namespace:PasswordVault.Converters"
			x:DataType="vm:PasswordListViewModel"
			x:Name="Root"
			xmlns:vm="using:PasswordVault.ViewModels"
			xmlns:m="using:PasswordVault.Models"
			mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
            x:Class="PasswordVault.Views.PasswordsPage"
			xmlns:local="clr-namespace:PasswordVault.Views">

	<!--<Design.DataContext>
		<vm:PasswordListViewModel/>
	</Design.DataContext>-->

	<Grid RowDefinitions="Auto,*" Margin="48,24" MaxWidth="1536">
		<StackPanel Grid.Row="0" Spacing="16" Margin="0,0,0,16">
			<DockPanel>
				<TextBlock TextWrapping="Wrap" Classes="h2" Text="Passwords" VerticalAlignment="Center"/>
				<StackPanel Orientation="Horizontal"
					 HorizontalAlignment="Right"
					 Spacing="8">
					<Button Classes="Outline" Command="{Binding RefreshCommand}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<icons:Lucide StrokeBrush="{DynamicResource ForegroundColor}" Icon="RefreshCw" Height="16" Width="16"/>
							<TextBlock Text="Refresh"/>
						</StackPanel>
					</Button>
					<Button Classes="Primary" Command="{Binding ShowAddPasswordDialogCommand}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<icons:Lucide Icon="Plus" Height="16" Width="16"/>
							<TextBlock Text="Add Password"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</DockPanel>
			<Grid ColumnDefinitions="*,Auto">
				<TextBox Grid.Column="0" Classes="Clearable" Watermark="Search passwords..."
					   Text="{Binding SearchText, Mode=TwoWay}"
					   extensions:ControlAssist.ShowProgress="{Binding IsSearching}"
					   Margin="0,0,8,0" VerticalAlignment="Center">
					<TextBox.InnerLeftContent>
						<icons:Lucide Icon="Search" StrokeBrush="{DynamicResource ForegroundColor}" Opacity="0.75" Height="16" Width="16" Margin="8,0,0,0"/>
					</TextBox.InnerLeftContent>
				</TextBox>
				<Button Grid.Column="1" Classes="Outline">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<icons:Lucide Icon="SlidersHorizontal" StrokeBrush="{DynamicResource ForegroundColor}" Height="16" Width="16"/>
						<TextBlock Text="Filter"/>
					</StackPanel>
				</Button>
			</Grid>
		</StackPanel>
		<ScrollViewer Grid.Row="1">
			<ItemsControl ItemsSource="{Binding Passwords}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Vertical" Spacing="8"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="m:Password">
						<controls:Card Padding="12">
							<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="4">
								<Button Classes="h4" Tag="{Binding Title}" Click="CopyTextButton_Click" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left">
									<TextBlock Grid.Row="0" Grid.Column="0"
									  Text="{Binding Title}"
									  ToolTip.Tip="Title"
									  Classes="h4"
									 />
								</Button>
								<Button Classes="p" Tag="{Binding Username}" Click="CopyTextButton_Click" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left">
									<TextBlock
										 Text="{Binding Username}"
										 Foreground="{DynamicResource ForegroundLeadColor}"
										 ToolTip.Tip="Username"
										 FontSize="12"/>
								</Button>
								<Button Grid.Row="2" Grid.Column="0" Classes="Ghost" HorizontalAlignment="Left" Padding="0,0,0,0"
										Tag="{Binding Id}"
										Click="CopyPasswordButton_Click"
										Content="••••••••••••••••" />
								<Button Grid.Row="2" Grid.Column="1"
									Classes="Icon" HorizontalAlignment="Right"
									ToolTip.Tip="Toggle Favorite">
									<!--Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=Root}"
									CommandParameter="{Binding .}"-->
									<Grid Width="18" Height="18" HorizontalAlignment="Center">
										<i:Icon Value="fa-regular fa-star"
												Foreground="{DynamicResource ForegroundColor}"
												IsVisible="{Binding !IsFavorite}" />
										<i:Icon Value="fa-solid fa-star"
												Foreground="Gold"
												IsVisible="{Binding IsFavorite}" />
									</Grid>
								</Button>
								<TextBlock Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource ForegroundLeadColor}" FontSize="11"
										   Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, yyyy}'}" VerticalAlignment="Center"/>
								<StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Spacing="3">
									<Border Background="{Binding Category.Color}" CornerRadius="6" VerticalAlignment="Center" Padding="4">
										<StackPanel Orientation="Horizontal" Spacing="5">
											<i:Icon Value="{Binding Category.Icon}" Foreground="{DynamicResource ForegroundColor}"/>
											<TextBlock Text="{Binding Category.Name}" ToolTip.Tip="Category" />
										</StackPanel>
									</Border>
									<TextBlock
									  Text="{Binding Tags, Converter={StaticResource JoinConverter}}"
									  ToolTip.Tip="Tags"
									/>
								</StackPanel>
							</Grid>
						</controls:Card>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</UserControl>
