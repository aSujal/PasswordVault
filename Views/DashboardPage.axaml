<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:PasswordVault.ViewModels"
			 xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
			 xmlns:fa="clr-namespace:PasswordVault.CustomIcons"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PasswordVault.Views.DashboardPage"
			 x:DataType="vm:DashboardViewModel">
	<Grid RowDefinitions="Auto,*" Margin="48,24" MaxWidth="1536">
		<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,24"> 
			<TextBlock Text="Dashboard" Classes="h2"/>
			<Button Classes="Icon" Command="{Binding LoadDashboardDataCommand}" ToolTip.Tip="Refresh">
					<fa:FontAwesomeIcon
						Width="16"
						Height="16"
						Foreground="{DynamicResource ForegroundColor}"
						Value="fa-solid fa-arrows-rotate" />
			</Button>
		</StackPanel>

		<ScrollViewer Grid.Row="1">
			<StackPanel Spacing="24">
				<!-- Stats Cards -->
				<Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
					<!-- Total Passwords -->
					<shadui:Card Grid.Column="0" Padding="20">
						<StackPanel Spacing="8">
							<fa:FontAwesomeIcon Value="fa-solid fa-key" Foreground="{DynamicResource PrimaryColor}" FontSize="24"/>
							<TextBlock Text="{Binding TotalPasswords}" Classes="h1"/>
							<TextBlock Text="Total Passwords" Foreground="{DynamicResource ForegroundLeadColor}"/>
						</StackPanel>
					</shadui:Card>

					<!-- Favorites -->
					<shadui:Card Grid.Column="1" Padding="20">
						<StackPanel Spacing="8">
							<fa:FontAwesomeIcon Value="fa-solid fa-star" Foreground="Gold" FontSize="24"/>
							<TextBlock Text="{Binding FavoritePasswords}" Classes="h1"/>
							<TextBlock Text="Favorites" Foreground="{DynamicResource ForegroundLeadColor}"/>
						</StackPanel>
					</shadui:Card>

					<!-- Weak Passwords -->
					<shadui:Card Grid.Column="2" Padding="20">
						<StackPanel Spacing="8">
							<fa:FontAwesomeIcon Value="fa-solid fa-triangle-exclamation" Foreground="Orange" FontSize="24"/>
							<TextBlock Text="{Binding WeakPasswords}" Classes="h1"/>
							<TextBlock Text="Weak Passwords" Foreground="{DynamicResource ForegroundLeadColor}"/>
						</StackPanel>
					</shadui:Card>

					<!-- Categories -->
					<shadui:Card Grid.Column="3" Padding="20">
						<StackPanel Spacing="8">
							<fa:FontAwesomeIcon Value="fa-solid fa-folder-open" Foreground="{DynamicResource PrimaryColor}" FontSize="24"/>
							<TextBlock Text="{Binding TotalCategories}" Classes="h1"/>
							<TextBlock Text="Categories" Foreground="{DynamicResource ForegroundLeadColor}"/>
						</StackPanel>
					</shadui:Card>
				</Grid>

				<!-- Recent Passwords and Category Stats -->
				<Grid ColumnDefinitions="2*,*" ColumnSpacing="16">
					<!-- Recent Passwords -->
					<shadui:Card Grid.Column="0" Padding="20">
						<StackPanel Spacing="16">
							<TextBlock Text="Recent Passwords" Classes="h3"/>
							<ItemsControl ItemsSource="{Binding RecentPasswords}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border BorderBrush="{DynamicResource BorderColor}"
												BorderThickness="0,0,0,1"
												Padding="0,8">
											<Grid ColumnDefinitions="Auto,*,Auto">
												<fa:FontAwesomeIcon Grid.Column="0"
														Value="{Binding Category.Icon}"
														Foreground="{Binding Category.Color}"
														FontSize="20"
														Margin="0,0,12,0"/>
												<StackPanel Grid.Column="1">
													<TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
													<TextBlock Text="{Binding Username}"
															   FontSize="12"
															   Foreground="{DynamicResource ForegroundLeadColor}"/>
												</StackPanel>
												<TextBlock Grid.Column="2"
														   Text="{Binding CreatedAt, StringFormat='{}{0:MMM d}'}"
														   FontSize="11"
														   Foreground="{DynamicResource ForegroundLeadColor}"
														   VerticalAlignment="Center"/>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</shadui:Card>

					<!-- Category Distribution -->
					<shadui:Card Grid.Column="1" Padding="20">
						<StackPanel Spacing="16">
							<TextBlock Text="Categories" Classes="h3"/>
							<ItemsControl ItemsSource="{Binding CategoryStats}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
											<fa:FontAwesomeIcon Grid.Column="0"
													Value="{Binding Category.Icon}"
													Foreground="{Binding Category.Color}"
													FontSize="18"
													Margin="0,0,8,0"/>
											<TextBlock Grid.Column="1"
													   Text="{Binding Category.Name}"
													   VerticalAlignment="Center"/>
											<Border Grid.Column="2"
													Background="{Binding Category.Color}"
													CornerRadius="10"
													Padding="8,4"
													MinWidth="30">
												<TextBlock Text="{Binding PasswordCount}"
													Foreground="White"
													HorizontalAlignment="Center"
													FontWeight="SemiBold"
													FontSize="12"/>
											</Border>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</shadui:Card>
				</Grid>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>