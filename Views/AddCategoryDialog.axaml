<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:i="https://github.com/projektanker/icons.avalonia"
	xmlns:vm="using:PasswordVault.ViewModels"
    xmlns:sys="using:System" 
	xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
	xmlns:converters="using:PasswordVault.Converters"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
	x:Class="PasswordVault.Views.AddCategoryDialog"
    x:Name="Root"
	x:DataType="vm:AddCategoryDialogViewModel">
    <UserControl.Styles>
        <Style Selector="Button.Outline">
             <Setter Property="HorizontalContentAlignment" Value="Center" />
             <Setter Property="VerticalContentAlignment" Value="Center" />
             <Setter Property="Padding" Value="4" />
             <Setter Property="Width" Value="36" />
             <Setter Property="Height" Value="36" />
        </Style>
    </UserControl.Styles>
	<StackPanel Spacing="16" Margin="24">
		<TextBlock Text="{Binding DialogTitle}" Classes="h3" />

		<StackPanel Spacing="8">
			<Label Content="Name" Target="NameBox" />
			<TextBox Name="NameBox" Watermark="e.g. Finance" Text="{Binding Name}" />
		</StackPanel>

		<StackPanel Spacing="8">
			<Label Content="Color" />
			<ColorPicker Name="ColorPicker"
				Color="{Binding SelectedColor, Converter={x:Static converters:StringToColorConverter.Instance}, Mode=TwoWay}"
				HorizontalAlignment="Stretch"
				shadui:ControlAssist.Hint="Pick a color"
				shadui:ControlAssist.Label="Category Color"
			/>
            <ItemsControl ItemsSource="{Binding #ColorPicker.(DataValidationErrors.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource destructive}" FontSize="12" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
		</StackPanel>

		<StackPanel Spacing="8">
			<Label Content="Icon" />
			<Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6"
				Padding="12" MaxHeight="200">
				<ScrollViewer>
					<ItemsControl ItemsSource="{Binding AvailableIcons}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="sys:String">
								<Button Classes="Icon" Margin="2"
									Command="{Binding $parent[UserControl].((vm:AddCategoryDialogViewModel)DataContext).SelectIconCommand}"
									CommandParameter="{Binding .}"
									ToolTip.Tip="{Binding .}"
                                    CornerRadius="4"
                                    Classes.Outline="{Binding $self.Tag, TargetNullValue=False, FallbackValue=False}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{x:Static converters:StringEqualityConverter.Instance}">
                                            <Binding Path="$parent[UserControl].((vm:AddCategoryDialogViewModel)DataContext).SelectedIcon" />
                                            <Binding Path="." />
                                        </MultiBinding>
                                    </Button.Tag>
									<Panel>
										<i:Icon Value="{Binding .}" />
									</Panel>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Border>
		</StackPanel>


		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
			Margin="0,10,0,0">
			<!-- Preview -->
			<Border Background="{Binding SelectedColor}" CornerRadius="6" Padding="8,4"
				VerticalAlignment="Center">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<i:Icon Value="{Binding SelectedIcon}" Foreground="White" Height="14" Width="14" />
					<TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Medium" />
				</StackPanel>
			</Border>

			<Button Command="{Binding CancelCommand}" Classes="Destructive">
				<TextBlock Text="Cancel" />
			</Button>

			<Button Command="{Binding SubmitCommand}" IsDefault="True" Classes="Primary">
				<TextBlock Text="{Binding SubmitButtonText}" />
			</Button>
		</StackPanel>
	</StackPanel>
</UserControl>