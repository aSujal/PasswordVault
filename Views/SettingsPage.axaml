<UserControl
  x:Class="PasswordVault.Views.SettingsPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fa="clr-namespace:PasswordVault.CustomIcons"
  xmlns:m="using:PasswordVault.Models"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:views="using:PasswordVault.Views"
  xmlns:vm="using:PasswordVault.ViewModels"
  d:DesignHeight="600"
  d:DesignWidth="800"
  x:DataType="vm:SettingsViewModel"
  mc:Ignorable="d">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">


    <StackPanel Margin="24" Spacing="24">
      <TextBlock Classes="h2" Text="Settings" />

      <TabControl>
        <!--  General Tab  -->
        <TabItem Header="General">
          <StackPanel Margin="0,16,0,0" Spacing="24">
            <!--  Theme Settings  -->
            <shadui:Card Padding="24">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="Appearance" />
                  <SelectableTextBlock
                    Classes="p"
                    Opacity="0.6"
                    Text="Customize the look and feel of the application." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="16">
                  <Button Classes="Outline" Command="{Binding SetLightCommand}">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-sun" />
                  </Button>
                  <Button Classes="Outline" Command="{Binding SetDarkCommand}">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-moon" />
                  </Button>
                  <Button Classes="Outline" Command="{Binding SetSystemCommand}">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-desktop" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </shadui:Card>

            <!--  Data Management  -->
            <shadui:Card Padding="24">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="Data Management" />
                  <TextBlock
                    Classes="p"
                    Opacity="0.6"
                    Text="Manage your categories and vault data." />
                </StackPanel>

                <StackPanel DataContext="{Binding BackupSettingsVM}" Spacing="16">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleSwitch IsChecked="{Binding AutoBackupEnabled}" Theme="{DynamicResource SimpleToggleSwitchTheme}" />
                    <StackPanel Spacing="2">
                      <TextBlock Classes="p" Text="Auto Backup" FontWeight="SemiBold" />
                      <TextBlock Classes="p" Opacity="0.6" FontSize="12" Text="Automatically back up your vault based on the schedule below" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel IsEnabled="{Binding AutoBackupEnabled}" IsVisible="{Binding AutoBackupEnabled}" Spacing="16">
                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="4">
                        <TextBlock Classes="p" FontSize="12" Opacity="0.6" Text="Frequency" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding BackupFrequencyOptions}" SelectedIndex="{Binding SelectedBackupFrequencyIndex}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="p" FontSize="12" Opacity="0.6" Text="Keep last N backups" />
                        <NumericUpDown Minimum="1" Maximum="365" Value="{Binding BackupRetentionCount}" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="p" FontSize="12" Opacity="0.6" Text="Backup location" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Margin="0,0,8,0" IsReadOnly="True" Text="{Binding BackupLocation}" />
                        <Button Grid.Column="1" Classes="Outline" Click="BrowseBackupLocationButton_Click">
                          <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-folder-open" />
                        </Button>
                      </Grid>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="p" FontSize="12" Opacity="0.6" Text="{Binding LastBackupText, StringFormat='Last backup: {0}'}" />
                      <Button Grid.Column="1" Classes="Outline" Command="{Binding BackupNowCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-database" />
                          <TextBlock Text="Backup Now" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </StackPanel>
                </StackPanel>

                <Button Classes="Outline" Command="{Binding ManageCategoriesCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-tags" />
                    <TextBlock Text="Manage Categories" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </shadui:Card>
            <!--  Security  -->
            <shadui:Card Padding="24">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="Security" />
                  <TextBlock
                    Classes="p"
                    Opacity="0.6"
                    Text="Change your master password. You need to know your current password." />
                </StackPanel>

                <TextBox
                  PasswordChar="•"
                  Classes="PasswordReveal"
                  Text="{Binding CurrentMasterPassword}"
                  PlaceholderText="Current master password" />
                <TextBox
                  PasswordChar="•"
                  Classes="PasswordReveal"
                  Text="{Binding NewMasterPassword}"
                  PlaceholderText="New master password (min. 8 characters)" />
                <TextBox
                  PasswordChar="•"
                  Classes="PasswordReveal"
                  Text="{Binding ConfirmNewMasterPassword}"
                  PlaceholderText="Confirm new master password" />

                <Button
                  Classes="Primary"
                  Command="{Binding ChangeMasterPasswordCommand}"
                  IsEnabled="{Binding !IsChangingPassword}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource BackgroundColor}" Value="fa-solid fa-lock" />
                    <TextBlock Text="Change Master Password" />
                  </StackPanel>
                </Button>

                <Border
                  Padding="12"
                  Background="{DynamicResource OutlineColor}"
                  CornerRadius="8"
                  IsVisible="{Binding HasPasswordChangeResult}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fa:FontAwesomeIcon
                      IsVisible="{Binding PasswordChangeSuccess}"
                      Foreground="MediumSeaGreen"
                      Value="fa-solid fa-check-circle" />
                    <fa:FontAwesomeIcon
                      IsVisible="{Binding !PasswordChangeSuccess}"
                      Foreground="IndianRed"
                      Value="fa-solid fa-circle-xmark" />
                    <TextBlock Text="{Binding PasswordChangeStatus}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </shadui:Card>

            <!--  App Updates  -->
            <shadui:Card Padding="24">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="App Updates" />
                  <TextBlock
                    Classes="p"
                    Opacity="0.6"
                    Text="{Binding UpdateStatus}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock VerticalAlignment="Center" Classes="p" Opacity="0.5" Text="Current Version: " />
                  <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Classes="p" Text="{Binding CurrentVersion, StringFormat='v{0}'}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                  <!-- Check Button -->
                  <Button
                    Classes="Outline"
                    Command="{Binding CheckForUpdatesCommand}"
                    IsEnabled="{Binding !IsChecking}"
                    IsVisible="{Binding ShowCheckButton}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-rotate" />
                      <TextBlock Text="Check for Updates" />
                    </StackPanel>
                  </Button>

                  <!-- Download Button -->
                  <Button
                    Classes="Primary"
                    Command="{Binding DownloadUpdateCommand}"
                    IsEnabled="{Binding !IsChecking}"
                    IsVisible="{Binding UpdateAvailable}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <fa:FontAwesomeIcon Foreground="{DynamicResource BackgroundColor}" Value="fa-solid fa-download" />
                      <TextBlock Text="Download Update" />
                    </StackPanel>
                  </Button>

                  <!-- Restart Button -->
                  <Button
                    Classes="Primary"
                    Command="{Binding RestartToApplyCommand}"
                    IsVisible="{Binding UpdateReadyToInstall}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <fa:FontAwesomeIcon Foreground="{DynamicResource BackgroundColor}" Value="fa-solid fa-circle-check" />
                      <TextBlock Text="Restart to Apply Update" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </shadui:Card>
          </StackPanel>
        </TabItem>

        <!--  Import & Export Tab  -->
        <TabItem Header="Import &amp; Export">
          <views:ImportExportPage Margin="0,16,0,0" DataContext="{Binding ImportExportVM}" />
        </TabItem>

        <!--  AI Assistant Tab  -->
        <TabItem Header="AI Assistant">
          <StackPanel Margin="0,16,0,0" Spacing="24" DataContext="{Binding AiSettingsVM}">
            
            <!-- Provider Selection -->
            <shadui:Card Padding="24">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="AI Provider" />
                  <TextBlock Classes="p" Opacity="0.6" Text="Pick an engine for auto-categorization. Local and free-tier options are marked." />
                </StackPanel>

                <Button Classes="Primary" Command="{Binding QuickSetupOllamaCommand}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource BackgroundColor}" Value="fa-solid fa-bolt" />
                    <TextBlock Text="One-Click Setup: Use Free Local AI (Ollama)" />
                  </StackPanel>
                </Button>

                <TextBlock Classes="p" FontSize="12" Opacity="0.6" Text="{Binding SelectedProviderDisplayName, StringFormat='Currently using: {0}'}" />

                <ItemsControl ItemsSource="{Binding AvailableProviders}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:ProviderInfo">
                      <Button
                        Margin="0,0,8,8"
                        Classes="Outline"
                        Command="{Binding $parent[ItemsControl].((vm:AiSettingsViewModel)DataContext).SelectProviderCommand}"
                        CommandParameter="{Binding Provider}"
                        ToolTip.Tip="{Binding Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding DisplayName}" />
                          <Border
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Background="MediumSeaGreen"
                            CornerRadius="4"
                            IsVisible="{Binding IsFree}">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="White" Text="FREE" />
                          </Border>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                  Classes="p"
                  FontSize="12"
                  IsVisible="{Binding IsAiEnabled}"
                  Opacity="0.7"
                  Text="{Binding SelectedProviderTip}"
                  TextWrapping="Wrap" />
              </StackPanel>
            </shadui:Card>

            <!-- Ollama Config -->
            <shadui:Card Padding="24" IsVisible="{Binding IsOllamaSelected}">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="Ollama Configuration" />
                  <TextBlock Classes="p" Opacity="0.6" Text="Local AI runs entirely on your machine. No data leaves your computer." />
                </StackPanel>

                <TextBox PlaceholderText="Endpoint (e.g. http://localhost:11434)" Text="{Binding OllamaEndpoint}" />

                <Grid ColumnDefinitions="*,Auto">
                  <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding AvailableOllamaModels}" PlaceholderText="Select a model or type manually" SelectedItem="{Binding OllamaModelName}" />
                  <Button Grid.Column="1" Margin="8,0,0,0" Classes="Outline" Command="{Binding RefreshOllamaModelsCommand}" ToolTip.Tip="Refresh installed models">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-arrows-rotate" />
                  </Button>
                </Grid>
                <TextBox IsVisible="{Binding !AvailableOllamaModels.Count}" PlaceholderText="Model name (fallback if dropdown is empty)" Text="{Binding OllamaModelName}" />
              </StackPanel>
            </shadui:Card>

            <!-- Cloud Config -->
            <shadui:Card Padding="24" IsVisible="{Binding IsCloudSelected}">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="Cloud AI Configuration" />
                  <TextBlock Classes="p" Opacity="0.6" Text="Enter your API key and preferred model name." />
                </StackPanel>

                <TextBox Classes="PasswordReveal" PasswordChar="•" PlaceholderText="API Key" Text="{Binding ApiKey}" />
                <TextBox PlaceholderText="Model name (e.g. gpt-4o-mini, gemini-2.5-flash)" Text="{Binding CloudModelName}" />
              </StackPanel>
            </shadui:Card>

            <!-- Privacy & Behavior -->
            <shadui:Card Padding="24" IsVisible="{Binding IsAiEnabled}">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="Privacy &amp; Behavior" />
                  <TextBlock Classes="p" Opacity="0.6" Text="Select which fields are shared with the AI, and how it should behave." />
                </StackPanel>

                <!-- Cloud Warning -->
                <Border Background="Red" Opacity="0.1" CornerRadius="8" IsVisible="{Binding IsCloudSelected}">
                  <TextBlock Foreground="White" Padding="12" Text="WARNING: Cloud AI sends selected entry data to external servers. Passwords and notes are NEVER sent." TextWrapping="Wrap" />
                </Border>

                <CheckBox Content="Send Title (Required for good results)" IsChecked="{Binding SendTitle}" />
                <CheckBox Content="Send URL (Highly recommended)" IsChecked="{Binding SendUrl}" />
                <CheckBox Content="Send Username" IsChecked="{Binding SendUsername}" />
                <Separator />
                <CheckBox Content="Suggest Tags (in addition to category)" IsChecked="{Binding SuggestTags}" />
              </StackPanel>
            </shadui:Card>

            <!-- Connection Test & Save -->
            <shadui:Card Padding="24" IsVisible="{Binding IsAiEnabled}">
              <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button Classes="Primary" Command="{Binding SaveAiSettingsCommand}" IsEnabled="{Binding !IsSavingAiSettings}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <fa:FontAwesomeIcon Value="fa-solid fa-floppy-disk" Foreground="{DynamicResource BackgroundColor}" />
                      <TextBlock Text="Save Settings" />
                    </StackPanel>
                  </Button>
                  
                  <Button Classes="Outline" Command="{Binding TestAiConnectionCommand}" IsEnabled="{Binding !IsTestingConnection}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <fa:FontAwesomeIcon Value="fa-solid fa-wifi" Foreground="{DynamicResource ForegroundColor}" />
                      <TextBlock Text="Test Connection" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <!-- Status output -->
                <Border Padding="12" CornerRadius="8" Background="{DynamicResource OutlineColor}" IsVisible="{Binding HasConnectionResult}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fa:FontAwesomeIcon IsVisible="{Binding IsConnectionSuccess}" Value="fa-solid fa-check-circle" Foreground="MediumSeaGreen" />
                    <fa:FontAwesomeIcon IsVisible="{Binding !IsConnectionSuccess}" Value="fa-solid fa-circle-xmark" Foreground="IndianRed" />
                    <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </shadui:Card>

          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
