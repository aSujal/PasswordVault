<UserControl
  x:Class="PasswordVault.Views.SettingsPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fa="clr-namespace:PasswordVault.CustomIcons"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:views="using:PasswordVault.Views"
  xmlns:vm="using:PasswordVault.ViewModels"
  d:DesignHeight="600"
  d:DesignWidth="800"
  x:DataType="vm:SettingsViewModel"
  mc:Ignorable="d">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">


    <StackPanel Margin="24" Spacing="24">
      <TextBlock Classes="h2" Text="Settings" />

      <TabControl>
        <!--  General Tab  -->
        <TabItem Header="General">
          <StackPanel Margin="0,16,0,0" Spacing="24">
            <!--  Theme Settings  -->
            <shadui:Card Padding="24">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="Appearance" />
                  <SelectableTextBlock
                    Classes="p"
                    Opacity="0.6"
                    Text="Customize the look and feel of the application." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="16">
                  <Button Classes="Outline" Command="{Binding SetLightCommand}">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-sun" />
                  </Button>
                  <Button Classes="Outline" Command="{Binding SetDarkCommand}">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-moon" />
                  </Button>
                  <Button Classes="Outline" Command="{Binding SetSystemCommand}">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-desktop" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </shadui:Card>

            <!--  Data Management  -->
            <shadui:Card Padding="24">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="Data Management" />
                  <TextBlock
                    Classes="p"
                    Opacity="0.6"
                    Text="Manage your categories and vault data." />
                </StackPanel>

                <Button Classes="Outline" Command="{Binding ManageCategoriesCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-tags" />
                    <TextBlock Text="Manage Categories" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </shadui:Card>

            <!--  App Updates  -->
            <shadui:Card Padding="24">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="App Updates" />
                  <TextBlock
                    Classes="p"
                    Opacity="0.6"
                    Text="{Binding UpdateStatus}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock VerticalAlignment="Center" Classes="p" Opacity="0.5" Text="Current Version: " />
                  <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Classes="p" Text="{Binding CurrentVersion, StringFormat='v{0}'}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                  <!-- Check Button -->
                  <Button
                    Classes="Outline"
                    Command="{Binding CheckForUpdatesCommand}"
                    IsEnabled="{Binding !IsChecking}"
                    IsVisible="{Binding ShowCheckButton}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-rotate" />
                      <TextBlock Text="Check for Updates" />
                    </StackPanel>
                  </Button>

                  <!-- Download Button -->
                  <Button
                    Classes="Primary"
                    Command="{Binding DownloadUpdateCommand}"
                    IsEnabled="{Binding !IsChecking}"
                    IsVisible="{Binding UpdateAvailable}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <fa:FontAwesomeIcon Foreground="{DynamicResource BackgroundColor}" Value="fa-solid fa-download" />
                      <TextBlock Text="Download Update" />
                    </StackPanel>
                  </Button>

                  <!-- Restart Button -->
                  <Button
                    Classes="Primary"
                    Command="{Binding RestartToApplyCommand}"
                    IsVisible="{Binding UpdateReadyToInstall}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <fa:FontAwesomeIcon Foreground="{DynamicResource BackgroundColor}" Value="fa-solid fa-circle-check" />
                      <TextBlock Text="Restart to Apply Update" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </shadui:Card>
          </StackPanel>
        </TabItem>

        <!--  Import & Export Tab  -->
        <TabItem Header="Import &amp; Export">
          <views:ImportExportPage Margin="0,16,0,0" DataContext="{Binding ImportExportVM}" />
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
