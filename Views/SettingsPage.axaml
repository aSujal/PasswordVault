<UserControl
  x:Class="PasswordVault.Views.SettingsPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fa="clr-namespace:PasswordVault.CustomIcons"
  xmlns:m="using:PasswordVault.Models"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:services="using:PasswordVault.Services"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:views="using:PasswordVault.Views"
  xmlns:vm="using:PasswordVault.ViewModels"
  d:DesignHeight="600"
  d:DesignWidth="800"
  x:DataType="vm:SettingsViewModel"
  mc:Ignorable="d">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">


    <StackPanel Margin="24" Spacing="24">
      <TextBlock Classes="h2" Text="Settings" />

      <TabControl>
        <!--  General Tab  -->
        <TabItem Header="General">
          <StackPanel Margin="0,16,0,0" Spacing="24">
            <!--  Theme Settings  -->
            <shadui:Card Padding="24">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="Appearance" />
                  <SelectableTextBlock
                    Classes="p"
                    Opacity="0.6"
                    Text="Customize the look and feel of the application." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="16">
                  <Button Classes="Outline" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.Light}" ToolTip.Tip="Light">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-sun" />
                  </Button>
                  <Button Classes="Outline" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.Dark}" ToolTip.Tip="Dark">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-moon" />
                  </Button>
                  <Button Classes="Outline" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.System}" ToolTip.Tip="System">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-desktop" />
                  </Button>
                  <Button Classes="Outline" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.Glass}" ToolTip.Tip="Glass">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-droplet" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </shadui:Card>

            <!--  Data Management  -->
            <shadui:Card Padding="24">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="Data Management" />
                  <TextBlock
                    Classes="p"
                    Opacity="0.6"
                    Text="Manage your categories and vault data." />
                </StackPanel>

                <StackPanel DataContext="{Binding BackupSettingsVM}" Spacing="16">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleSwitch IsChecked="{Binding AutoBackupEnabled}" Theme="{DynamicResource SimpleToggleSwitchTheme}" />
                    <StackPanel Spacing="2">
                      <TextBlock Classes="p" Text="Auto Backup" FontWeight="SemiBold" />
                      <TextBlock Classes="p" Opacity="0.6" FontSize="12" Text="Automatically back up your vault based on the schedule below" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel IsEnabled="{Binding AutoBackupEnabled}" IsVisible="{Binding AutoBackupEnabled}" Spacing="16">
                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="4">
                        <TextBlock Classes="p" FontSize="12" Opacity="0.6" Text="Frequency" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding BackupFrequencyOptions}" SelectedIndex="{Binding SelectedBackupFrequencyIndex}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="p" FontSize="12" Opacity="0.6" Text="Keep last N backups" />
                        <NumericUpDown Minimum="1" Maximum="365" Value="{Binding BackupRetentionCount}" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="p" FontSize="12" Opacity="0.6" Text="Backup location" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Margin="0,0,8,0" IsReadOnly="True" Text="{Binding BackupLocation}" />
                        <Button Grid.Column="1" Classes="Outline" Click="BrowseBackupLocationButton_Click">
                          <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-folder-open" />
                        </Button>
                      </Grid>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="p" FontSize="12" Opacity="0.6" Text="{Binding LastBackupText, StringFormat='Last backup: {0}'}" />
                      <Button Grid.Column="1" Classes="Outline" Command="{Binding BackupNowCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-database" />
                          <TextBlock Text="Backup Now" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </StackPanel>
                </StackPanel>

                <Button Classes="Outline" Command="{Binding ManageCategoriesVM.OpenCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-tags" />
                    <TextBlock Text="Manage Categories" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </shadui:Card>
            <!--  Security  -->
            <shadui:Card Padding="24">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="Security" />
                  <TextBlock
                    Classes="p"
                    Opacity="0.6"
                    Text="Change your master password. You need to know your current password." />
                </StackPanel>

                <TextBox
                  PasswordChar="•"
                  Classes="PasswordReveal"
                  Text="{Binding CurrentMasterPassword}"
                  PlaceholderText="Current master password" />
                <TextBox
                  PasswordChar="•"
                  Classes="PasswordReveal"
                  Text="{Binding NewMasterPassword}"
                  PlaceholderText="New master password (min. 8 characters)" />
                <TextBox
                  PasswordChar="•"
                  Classes="PasswordReveal"
                  Text="{Binding ConfirmNewMasterPassword}"
                  PlaceholderText="Confirm new master password" />

                <Button
                  Classes="Primary"
                  Command="{Binding ChangeMasterPasswordCommand}"
                  IsEnabled="{Binding !IsChangingPassword}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fa:FontAwesomeIcon Value="fa-solid fa-lock" />
                    <TextBlock Text="Change Master Password" />
                  </StackPanel>
                </Button>

                <Border
                  Padding="12"
                  Background="{DynamicResource OutlineColor}"
                  CornerRadius="8"
                  IsVisible="{Binding HasPasswordChangeResult}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fa:FontAwesomeIcon
                      IsVisible="{Binding PasswordChangeSuccess}"
                      Foreground="MediumSeaGreen"
                      Value="fa-solid fa-check-circle" />
                    <fa:FontAwesomeIcon
                      IsVisible="{Binding !PasswordChangeSuccess}"
                      Foreground="IndianRed"
                      Value="fa-solid fa-circle-xmark" />
                    <TextBlock Text="{Binding PasswordChangeStatus}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </shadui:Card>

            <!--  App Updates  -->
            <shadui:Card Padding="24">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h4" Text="App Updates" />
                  <TextBlock
                    Classes="p"
                    Opacity="0.6"
                    Text="{Binding UpdateStatus}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock VerticalAlignment="Center" Classes="p" Opacity="0.5" Text="Current Version: " />
                  <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Classes="p" Text="{Binding CurrentVersion, StringFormat='v{0}'}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                  <!-- Check Button -->
                  <Button
                    Classes="Outline"
                    Command="{Binding CheckForUpdatesCommand}"
                    IsEnabled="{Binding !IsChecking}"
                    IsVisible="{Binding ShowCheckButton}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <fa:FontAwesomeIcon Foreground="{DynamicResource ForegroundColor}" Value="fa-solid fa-rotate" />
                      <TextBlock Text="Check for Updates" />
                    </StackPanel>
                  </Button>

                  <!-- Download Button -->
                  <Button
                    Classes="Primary"
                    Command="{Binding DownloadUpdateCommand}"
                    IsEnabled="{Binding !IsChecking}"
                    IsVisible="{Binding UpdateAvailable}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <fa:FontAwesomeIcon Value="fa-solid fa-download" />
                      <TextBlock Text="Download Update" />
                    </StackPanel>
                  </Button>

                  <!-- Restart Button -->
                  <Button
                    Classes="Primary"
                    Command="{Binding RestartToApplyCommand}"
                    IsVisible="{Binding UpdateReadyToInstall}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <fa:FontAwesomeIcon Value="fa-solid fa-circle-check" />
                      <TextBlock Text="Restart to Apply Update" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </shadui:Card>
          </StackPanel>
        </TabItem>

        <!--  Import & Export Tab  -->
        <TabItem Header="Import &amp; Export">
          <views:ImportExportPage Margin="0,16,0,0" DataContext="{Binding ImportExportVM}" />
        </TabItem>

        <!--  AI Assistant Tab  -->
        <TabItem Header="AI Assistant">
          <shadui:Card Margin="0,16,0,0" Padding="24" DataContext="{Binding AiSettingsVM}">
            <StackPanel Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock Classes="h4" Text="Auto-Categorization" />
                <TextBlock Classes="p" Opacity="0.6" Text="{Binding Description}" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="p" FontSize="12" Opacity="0.6" Text="Provider" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="m:ProviderInfo">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel IsVisible="{Binding IsEnabled}" Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Classes="p" FontSize="12" Opacity="0.6" Text="Model" />
                  <TextBox PlaceholderText="{Binding SelectedProvider.DefaultModel}" Text="{Binding Model}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsCloud}" Spacing="4">
                  <TextBlock Classes="p" FontSize="12" Opacity="0.6" Text="API key" />
                  <TextBox Classes="PasswordReveal" PasswordChar="•" Text="{Binding ApiKey}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Classes="p" FontSize="12" Opacity="0.6" IsVisible="{Binding !IsStatusError}" Text="{Binding Status}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Classes="p" FontSize="12" Foreground="IndianRed" IsVisible="{Binding IsStatusError}" Text="{Binding Status}" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Margin="0,0,8,0" Classes="Outline" Command="{Binding DownloadModelCommand}" IsVisible="{Binding IsOllama}">
                    <TextBlock Text="Download Model" />
                  </Button>
                  <Button Grid.Column="2" Classes="Outline" Command="{Binding TestCommand}">
                    <TextBlock Text="Test" />
                  </Button>
                </Grid>
              </StackPanel>
            </StackPanel>
          </shadui:Card>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
